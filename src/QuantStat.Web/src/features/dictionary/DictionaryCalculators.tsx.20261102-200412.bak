import {
  Area,
  CartesianGrid,
  ComposedChart,
  Line,
  ReferenceLine,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from 'recharts'

import {
  useMemo,
  useState,
} from 'react'


type Alternative =
  | 'two-sided'
  | 'less'
  | 'greater'


interface CurvePoint {
  x: number
  density: number
  rejection: number | null
}


interface HistogramPoint {
  x: number
  label: string
  observed: number
  normal: number
}


function parseValues(
  input: string,
): number[] {
  return input
    .split(/[\s,;]+/)
    .map(value =>
      Number(value),
    )
    .filter(value =>
      Number.isFinite(value),
    )
}


function mean(
  values: number[],
): number {
  return values.reduce(
    (sum, value) =>
      sum + value,
    0,
  ) / values.length
}


function sampleVariance(
  values: number[],
): number {
  if (values.length < 2) {
    return Number.NaN
  }

  const average =
    mean(values)

  return values.reduce(
    (sum, value) =>
      sum +
      (
        value -
        average
      ) ** 2,
    0,
  ) /
  (values.length - 1)
}


function sampleStandardDeviation(
  values: number[],
): number {
  return Math.sqrt(
    sampleVariance(values),
  )
}


/*
 * Lanczos approximation for log Gamma.
 */
function logGamma(
  value: number,
): number {
  const coefficients = [
    676.5203681218851,
    -1259.1392167224028,
    771.3234287776531,
    -176.6150291621406,
    12.507343278686905,
    -0.13857109526572012,
    0.000009984369578019572,
    0.00000015056327351493116,
  ]

  if (value < 0.5) {
    return (
      Math.log(Math.PI) -
      Math.log(
        Math.sin(
          Math.PI * value,
        ),
      ) -
      logGamma(
        1 - value,
      )
    )
  }

  const adjusted =
    value - 1

  let series =
    0.9999999999998099

  for (
    let index = 0;
    index < coefficients.length;
    index++
  ) {
    series +=
      coefficients[index] /
      (
        adjusted +
        index +
        1
      )
  }

  const t =
    adjusted +
    coefficients.length -
    0.5

  return (
    0.5 *
    Math.log(
      2 * Math.PI,
    ) +
    (
      adjusted +
      0.5
    ) *
    Math.log(t) -
    t +
    Math.log(series)
  )
}


function tDensity(
  x: number,
  degreesOfFreedom: number,
): number {
  const df =
    degreesOfFreedom

  const logCoefficient =
    logGamma(
      (df + 1) / 2,
    ) -
    logGamma(
      df / 2,
    ) -
    0.5 *
    Math.log(
      df *
      Math.PI,
    )

  return (
    Math.exp(
      logCoefficient,
    ) *
    (
      1 +
      x * x / df
    ) **
    (
      -(df + 1) / 2
    )
  )
}


function normalDensity(
  x: number,
): number {
  return (
    Math.exp(
      -0.5 *
      x *
      x,
    ) /
    Math.sqrt(
      2 *
      Math.PI,
    )
  )
}


/*
 * Error-function approximation.
 */
function erf(
  value: number,
): number {
  const sign =
    value < 0
      ? -1
      : 1

  const x =
    Math.abs(value)

  const t =
    1 /
    (
      1 +
      0.3275911 *
      x
    )

  const result =
    1 -
    (
      (
        (
          (
            (
              1.061405429 *
              t -
              1.453152027
            ) *
            t +
            1.421413741
          ) *
          t -
          0.284496736
        ) *
        t +
        0.254829592
      ) *
      t
    ) *
    Math.exp(
      -x *
      x,
    )

  return sign *
    result
}


function normalCdf(
  value: number,
): number {
  return (
    1 +
    erf(
      value /
      Math.sqrt(2),
    )
  ) /
  2
}


function inverseNormal(
  probability: number,
): number {
  let lower =
    -8

  let upper =
    8

  for (
    let iteration = 0;
    iteration < 100;
    iteration++
  ) {
    const middle =
      (
        lower +
        upper
      ) /
      2

    if (
      normalCdf(middle) <
      probability
    ) {
      lower =
        middle
    }
    else {
      upper =
        middle
    }
  }

  return (
    lower +
    upper
  ) /
  2
}


/*
 * Simpson numerical integration of Student t density.
 */
function tCdf(
  value: number,
  degreesOfFreedom: number,
): number {
  if (value === 0) {
    return 0.5
  }

  const absolute =
    Math.abs(value)

  const intervalCount =
    1000

  const step =
    absolute /
    intervalCount

  let total =
    tDensity(
      0,
      degreesOfFreedom,
    ) +
    tDensity(
      absolute,
      degreesOfFreedom,
    )

  for (
    let index = 1;
    index < intervalCount;
    index++
  ) {
    const multiplier =
      index % 2 === 0
        ? 2
        : 4

    total +=
      multiplier *
      tDensity(
        index * step,
        degreesOfFreedom,
      )
  }

  const integral =
    total *
    step /
    3

  return value > 0
    ? 0.5 + integral
    : 0.5 - integral
}


function inverseT(
  probability: number,
  degreesOfFreedom: number,
): number {
  let lower =
    -20

  let upper =
    20

  for (
    let iteration = 0;
    iteration < 80;
    iteration++
  ) {
    const middle =
      (
        lower +
        upper
      ) /
      2

    if (
      tCdf(
        middle,
        degreesOfFreedom,
      ) <
      probability
    ) {
      lower =
        middle
    }
    else {
      upper =
        middle
    }
  }

  return (
    lower +
    upper
  ) /
  2
}


function pValueFromCdf(
  cdf: number,
  alternative: Alternative,
): number {
  if (
    alternative ===
    'less'
  ) {
    return cdf
  }

  if (
    alternative ===
    'greater'
  ) {
    return 1 - cdf
  }

  return Math.min(
    1,
    2 *
    Math.min(
      cdf,
      1 - cdf,
    ),
  )
}

function criticalBoundaries(
  alpha: number,
  alternative: Alternative,
  inverse:
    (
      probability: number,
    ) => number,
): {
  lower: number | null
  upper: number | null
} {
  if (
    alternative ===
    'less'
  ) {
    return {
      lower:
        inverse(alpha),
      upper:
        null,
    }
  }

  if (
    alternative ===
    'greater'
  ) {
    return {
      lower:
        null,
      upper:
        inverse(
          1 - alpha,
        ),
    }
  }

  return {
    lower:
      inverse(
        alpha / 2,
      ),
    upper:
      inverse(
        1 -
        alpha / 2,
      ),
  }
}


function createCurve(
  density:
    (
      value: number,
    ) => number,
  lower: number | null,
  upper: number | null,
): CurvePoint[] {
  const points: CurvePoint[] =
    []

  const minimum =
    -5

  const maximum =
    5

  const count =
    240

  for (
    let index = 0;
    index <= count;
    index++
  ) {
    const x =
      minimum +
      (
        maximum -
        minimum
      ) *
      index /
      count

    const y =
      density(x)

    const rejected =
      (
        lower !== null &&
        x <= lower
      ) ||
      (
        upper !== null &&
        x >= upper
      )

    points.push({
      x:
        Number(
          x.toFixed(3),
        ),

      density:
        y,

      rejection:
        rejected
          ? y
          : null,
    })
  }

  return points
}


function alternativeLabel(
  alternative: Alternative,
): string {
  if (
    alternative ===
    'less'
  ) {
    return 'Mean is less than the null value'
  }

  if (
    alternative ===
    'greater'
  ) {
    return 'Mean is greater than the null value'
  }

  return 'Mean differs from the null value'
}


interface TestGraphProps {
  distribution:
    'Student t' |
    'Standard normal'

  curve: CurvePoint[]
  statistic: number
  lower: number | null
  upper: number | null
}


function TestGraph({
  distribution,
  curve,
  statistic,
  lower,
  upper,
}: TestGraphProps) {
  return (
    <div className="test-chart">

      <ResponsiveContainer>

        <ComposedChart
          data={curve}
          margin={{
            top: 18,
            right: 18,
            bottom: 4,
            left: 4,
          }}
        >

          <CartesianGrid
            stroke="var(--grid)"
            strokeDasharray="3 3"
            vertical={false}
          />


          <XAxis
            type="number"
            dataKey="x"
            domain={[-5, 5]}
            ticks={[
              -4,
              -2,
              0,
              2,
              4,
            ]}
            tick={{
              fill:
                'var(--muted)',
              fontSize: 10,
            }}
          />


          <YAxis
            hide
            domain={[
              0,
              'auto',
            ]}
          />


          <Tooltip
            contentStyle={{
              background:
                'var(--tooltip)',
              border:
                '1px solid var(--border)',
              borderRadius: 12,
              color:
                'var(--text)',
            }}
            formatter={value => [
              Number(value)
                .toFixed(5),
              'Density',
            ]}
            labelFormatter={value =>
              `${distribution} value: ${
                Number(value)
                  .toFixed(3)
              }`
            }
          />


          <Area
            type="monotone"
            dataKey="rejection"
            stroke="none"
            fill="#fb7185"
            fillOpacity={0.33}
            connectNulls={false}
            name="Rejection region"
          />


          <Line
            type="monotone"
            dataKey="density"
            stroke="#6c8cff"
            strokeWidth={2.2}
            dot={false}
            name={`${distribution} density`}
          />


          {lower !== null && (
            <ReferenceLine
              x={lower}
              stroke="#fb7185"
              strokeDasharray="5 5"
              label={{
                value: 'Critical',
                fill: '#fb7185',
                fontSize: 9,
              }}
            />
          )}


          {upper !== null && (
            <ReferenceLine
              x={upper}
              stroke="#fb7185"
              strokeDasharray="5 5"
              label={{
                value: 'Critical',
                fill: '#fb7185',
                fontSize: 9,
              }}
            />
          )}


          {Number.isFinite(
            statistic,
          ) && (
            <ReferenceLine
              x={statistic}
              stroke="#f59e0b"
              strokeWidth={2}
              label={{
                value: 'Observed',
                fill: '#f59e0b',
                fontSize: 9,
              }}
            />
          )}

        </ComposedChart>

      </ResponsiveContainer>

    </div>
  )
}


function Decision({
  pValue,
  alpha,
}: {
  pValue: number
  alpha: number
}) {
  const reject =
    pValue <= alpha

  return (
    <div
      className={
        reject
          ? 'test-decision reject'
          : 'test-decision retain'
      }
    >
      <span>
        Statistical decision
      </span>

      <strong>
        {reject
          ? 'Reject the null hypothesis'
          : 'Do not reject the null hypothesis'}
      </strong>

      <small>
        Because p-value {
          reject
            ? '<='
            : '>'
        } alpha.
      </small>
    </div>
  )
}


function OneSampleTTest() {
  const [sampleMean, setSampleMean] =
    useState('102')

  const [nullMean, setNullMean] =
    useState('100')

  const [sampleSd, setSampleSd] =
    useState('8')

  const [sampleSize, setSampleSize] =
    useState('25')

  const [alphaText, setAlphaText] =
    useState('0.05')

  const [
    alternative,
    setAlternative,
  ] =
    useState<Alternative>(
      'two-sided',
    )


  const xBar =
    Number(sampleMean)

  const muZero =
    Number(nullMean)

  const standardDeviation =
    Number(sampleSd)

  const n =
    Number(sampleSize)

  const alpha =
    Number(alphaText)

  const degreesOfFreedom =
    n - 1

  const standardError =
    (
      standardDeviation > 0 &&
      n > 0
    )
      ? standardDeviation /
        Math.sqrt(n)
      : Number.NaN

  const statistic =
    Number.isFinite(
      standardError,
    )
      ? (
          xBar -
          muZero
        ) /
        standardError
      : Number.NaN

  const valid =
    Number.isFinite(
      statistic,
    ) &&
    degreesOfFreedom > 0 &&
    alpha > 0 &&
    alpha < 1

  const cdf =
    valid
      ? tCdf(
          statistic,
          degreesOfFreedom,
        )
      : Number.NaN

  const pValue =
    valid
      ? pValueFromCdf(
          cdf,
          alternative,
        )
      : Number.NaN

  const boundaries =
    valid
      ? criticalBoundaries(
          alpha,
          alternative,
          probability =>
            inverseT(
              probability,
              degreesOfFreedom,
            ),
        )
      : {
          lower: null,
          upper: null,
        }

  const curve =
    useMemo(
      () =>
        createCurve(
          value =>
            tDensity(
              value,
              Math.max(
                1,
                degreesOfFreedom,
              ),
            ),
          boundaries.lower,
          boundaries.upper,
        ),
      [
        degreesOfFreedom,
        boundaries.lower,
        boundaries.upper,
      ],
    )


  return (
    <article className="hypothesis-test-card">

      <div className="test-card-heading">

        <div>
          <span>
            Unknown population standard deviation
          </span>

          <h3>
            One-sample t-test
          </h3>

          <p>
            Tests whether a population mean is
            consistent with a specified value when
            the population standard deviation is
            estimated from the sample.
          </p>
        </div>

      </div>


      <div className="test-hypotheses">

        <div>
          <span>
            Null hypothesis
          </span>

          <strong>
            H0: population mean = {
              nullMean || 'mu_0'
            }
          </strong>
        </div>

        <div>
          <span>
            Alternative hypothesis
          </span>

          <strong>
            {alternativeLabel(
              alternative,
            )}
          </strong>
        </div>

      </div>


      <div className="test-input-grid">

        <label>
          Sample mean
          <input
            type="number"
            value={sampleMean}
            onChange={event =>
              setSampleMean(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Null mean
          <input
            type="number"
            value={nullMean}
            onChange={event =>
              setNullMean(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Sample standard deviation
          <input
            type="number"
            min="0"
            value={sampleSd}
            onChange={event =>
              setSampleSd(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Sample size
          <input
            type="number"
            min="2"
            step="1"
            value={sampleSize}
            onChange={event =>
              setSampleSize(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Significance level
          <select
            value={alphaText}
            onChange={event =>
              setAlphaText(
                event.target.value,
              )
            }
          >
            <option value="0.10">
              0.10
            </option>

            <option value="0.05">
              0.05
            </option>

            <option value="0.01">
              0.01
            </option>
          </select>
        </label>


        <label>
          Alternative
          <select
            value={alternative}
            onChange={event =>
              setAlternative(
                event.target.value as Alternative
              )
            }
          >
            <option value="two-sided">
              Two-sided
            </option>

            <option value="less">
              Less than
            </option>

            <option value="greater">
              Greater than
            </option>
          </select>
        </label>

      </div>


      <TestGraph
        distribution="Student t"
        curve={curve}
        statistic={statistic}
        lower={boundaries.lower}
        upper={boundaries.upper}
      />


      <div className="test-result-grid">

        <div>
          <span>
            t statistic
          </span>

          <strong>
            {valid
              ? statistic.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            Degrees of freedom
          </span>

          <strong>
            {degreesOfFreedom > 0
              ? degreesOfFreedom
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            Standard error
          </span>

          <strong>
            {Number.isFinite(
              standardError,
            )
              ? standardError.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            p-value
          </span>

          <strong>
            {valid
              ? pValue.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>

      </div>


      {valid && (
        <Decision
          pValue={pValue}
          alpha={alpha}
        />
      )}


      <div className="test-explanation">
        <strong>
          How to read this test
        </strong>

        <p>
          The orange line is the observed t
          statistic. Red areas are rejection
          regions determined by the significance
          level and the selected alternative.
          A small p-value indicates that the
          observed sample mean is difficult to
          reconcile with the null hypothesis.
        </p>
      </div>

    </article>
  )
}


function OneSampleZTest() {
  const [sampleMean, setSampleMean] =
    useState('102')

  const [nullMean, setNullMean] =
    useState('100')

  const [populationSd, setPopulationSd] =
    useState('10')

  const [sampleSize, setSampleSize] =
    useState('36')

  const [alphaText, setAlphaText] =
    useState('0.05')

  const [
    alternative,
    setAlternative,
  ] =
    useState<Alternative>(
      'two-sided',
    )


  const xBar =
    Number(sampleMean)

  const muZero =
    Number(nullMean)

  const sigma =
    Number(populationSd)

  const n =
    Number(sampleSize)

  const alpha =
    Number(alphaText)

  const standardError =
    sigma > 0 && n > 0
      ? sigma /
        Math.sqrt(n)
      : Number.NaN

  const statistic =
    Number.isFinite(
      standardError,
    )
      ? (
          xBar -
          muZero
        ) /
        standardError
      : Number.NaN

  const valid =
    Number.isFinite(
      statistic,
    ) &&
    alpha > 0 &&
    alpha < 1

  const cdf =
    valid
      ? normalCdf(statistic)
      : Number.NaN

  const pValue =
    valid
      ? pValueFromCdf(
          cdf,
          alternative,
        )
      : Number.NaN

  const boundaries =
    valid
      ? criticalBoundaries(
          alpha,
          alternative,
          inverseNormal,
        )
      : {
          lower: null,
          upper: null,
        }

  const curve =
    useMemo(
      () =>
        createCurve(
          normalDensity,
          boundaries.lower,
          boundaries.upper,
        ),
      [
        boundaries.lower,
        boundaries.upper,
      ],
    )


  return (
    <article className="hypothesis-test-card">

      <div className="test-card-heading">

        <div>
          <span>
            Known population standard deviation
          </span>

          <h3>
            One-sample z-test
          </h3>

          <p>
            Tests a population mean using the
            standard normal distribution when the
            population standard deviation is known.
          </p>
        </div>

      </div>


      <div className="test-hypotheses">

        <div>
          <span>
            Null hypothesis
          </span>

          <strong>
            H0: population mean = {
              nullMean || 'mu_0'
            }
          </strong>
        </div>

        <div>
          <span>
            Alternative hypothesis
          </span>

          <strong>
            {alternativeLabel(
              alternative,
            )}
          </strong>
        </div>

      </div>


      <div className="test-input-grid">

        <label>
          Sample mean
          <input
            type="number"
            value={sampleMean}
            onChange={event =>
              setSampleMean(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Null mean
          <input
            type="number"
            value={nullMean}
            onChange={event =>
              setNullMean(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Known population SD
          <input
            type="number"
            min="0"
            value={populationSd}
            onChange={event =>
              setPopulationSd(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Sample size
          <input
            type="number"
            min="1"
            step="1"
            value={sampleSize}
            onChange={event =>
              setSampleSize(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Significance level
          <select
            value={alphaText}
            onChange={event =>
              setAlphaText(
                event.target.value,
              )
            }
          >
            <option value="0.10">
              0.10
            </option>

            <option value="0.05">
              0.05
            </option>

            <option value="0.01">
              0.01
            </option>
          </select>
        </label>


        <label>
          Alternative
          <select
            value={alternative}
            onChange={event =>
              setAlternative(
                event.target.value as Alternative
              )
            }
          >
            <option value="two-sided">
              Two-sided
            </option>

            <option value="less">
              Less than
            </option>

            <option value="greater">
              Greater than
            </option>
          </select>
        </label>

      </div>


      <TestGraph
        distribution="Standard normal"
        curve={curve}
        statistic={statistic}
        lower={boundaries.lower}
        upper={boundaries.upper}
      />


      <div className="test-result-grid">

        <div>
          <span>
            z statistic
          </span>

          <strong>
            {valid
              ? statistic.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            Standard error
          </span>

          <strong>
            {Number.isFinite(
              standardError,
            )
              ? standardError.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            p-value
          </span>

          <strong>
            {valid
              ? pValue.toFixed(6)
              : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          </strong>
        </div>


        <div>
          <span>
            Significance level
          </span>

          <strong>
            {alpha.toFixed(2)}
          </strong>
        </div>

      </div>


      {valid && (
        <Decision
          pValue={pValue}
          alpha={alpha}
        />
      )}


      <div className="test-explanation">
        <strong>
          When to use this test
        </strong>

        <p>
          Use the z-test only when the population
          standard deviation is genuinely known or
          justified externally. If it is estimated
          from the same sample, the one-sample
          t-test is generally the appropriate mean
          test.
        </p>
      </div>

    </article>
  )
}


function createNormalityHistogram(
  values: number[],
): HistogramPoint[] {
  if (values.length < 3) {
    return []
  }

  const average =
    mean(values)

  const standardDeviation =
    sampleStandardDeviation(
      values,
    )

  if (
    !Number.isFinite(
      standardDeviation,
    ) ||
    standardDeviation <= 0
  ) {
    return []
  }

  const minimum =
    Math.min(...values)

  const maximum =
    Math.max(...values)

  const binCount =
    Math.max(
      8,
      Math.min(
        24,
        Math.ceil(
          Math.sqrt(
            values.length,
          ),
        ) *
        2,
      ),
    )

  const width =
    (
      maximum -
      minimum
    ) /
    binCount

  if (width <= 0) {
    return []
  }

  const frequencies =
    Array.from(
      {
        length:
          binCount,
      },
      () => 0,
    )

  for (const value of values) {
    let index =
      Math.floor(
        (
          value -
          minimum
        ) /
        width,
      )

    if (
      index >= binCount
    ) {
      index =
        binCount - 1
    }

    frequencies[index]++
  }

  return frequencies.map(
    (
      observed,
      index,
    ) => {
      const midpoint =
        minimum +
        (
          index +
          0.5
        ) *
        width

      const z =
        (
          midpoint -
          average
        ) /
        standardDeviation

      const expectedDensity =
        normalDensity(z) /
        standardDeviation

      const expectedFrequency =
        expectedDensity *
        width *
        values.length

      return {
        x:
          midpoint,

        label:
          midpoint.toFixed(2),

        observed,

        normal:
          expectedFrequency,
      }
    },
  )
}


function JarqueBeraNormalityTest() {
  const [valuesInput, setValuesInput] =
    useState(
      '10.2, 9.7, 10.5, 11.0, 9.9, 10.1, 10.8, 9.6, 10.4, 10.0, 10.3, 9.8',
    )

  const [alphaText, setAlphaText] =
    useState('0.05')


  const values =
    useMemo(
      () =>
        parseValues(
          valuesInput,
        ),
      [valuesInput],
    )

  const alpha =
    Number(alphaText)

  const result =
    useMemo(() => {
      const n =
        values.length

      if (n < 4) {
        return null
      }

      const average =
        mean(values)

      const deviations =
        values.map(
          value =>
            value -
            average,
        )

      const secondMoment =
        deviations.reduce(
          (sum, value) =>
            sum +
            value ** 2,
          0,
        ) /
        n

      if (
        secondMoment <= 0
      ) {
        return null
      }

      const thirdMoment =
        deviations.reduce(
          (sum, value) =>
            sum +
            value ** 3,
          0,
        ) /
        n

      const fourthMoment =
        deviations.reduce(
          (sum, value) =>
            sum +
            value ** 4,
          0,
        ) /
        n

      const skewness =
        thirdMoment /
        (
          secondMoment **
          1.5
        )

      const excessKurtosis =
        fourthMoment /
        (
          secondMoment **
          2
        ) -
        3

      const statistic =
        n /
        6 *
        (
          skewness ** 2 +
          excessKurtosis ** 2 /
          4
        )

      /*
       * The asymptotic reference distribution
       * has two degrees of freedom. Its upper
       * tail probability is exp(-JB / 2).
       */
      const pValue =
        Math.exp(
          -statistic /
          2,
        )

      return {
        count: n,
        average,
        standardDeviation:
          sampleStandardDeviation(
            values,
          ),
        skewness,
        excessKurtosis,
        statistic,
        pValue,
      }
    }, [values])


  const histogram =
    useMemo(
      () =>
        createNormalityHistogram(
          values,
        ),
      [values],
    )


  return (
    <article className="hypothesis-test-card normality-test-card">

      <div className="test-card-heading">

        <div>
          <span>
            Distribution diagnostic
          </span>

          <h3>
            Jarque-Bera normality test
          </h3>

          <p>
            Assesses whether sample skewness and
            kurtosis are consistent with a normal
            distribution. The histogram provides a
            visual comparison with a fitted normal
            curve.
          </p>
        </div>

      </div>


      <div className="test-hypotheses">

        <div>
          <span>
            Null hypothesis
          </span>

          <strong>
            H0: the population distribution is normal
          </strong>
        </div>

        <div>
          <span>
            Alternative hypothesis
          </span>

          <strong>
            H1: the population distribution is not normal
          </strong>
        </div>

      </div>


      <div className="normality-input-layout">

        <label>
          Sample values
          <textarea
            value={valuesInput}
            onChange={event =>
              setValuesInput(
                event.target.value,
              )
            }
          />
        </label>


        <label>
          Significance level
          <select
            value={alphaText}
            onChange={event =>
              setAlphaText(
                event.target.value,
              )
            }
          >
            <option value="0.10">
              0.10
            </option>

            <option value="0.05">
              0.05
            </option>

            <option value="0.01">
              0.01
            </option>
          </select>
        </label>

      </div>


      {histogram.length > 0 && (
        <div className="normality-chart">

          <ResponsiveContainer>

            <ComposedChart
              data={histogram}
              margin={{
                top: 18,
                right: 18,
                bottom: 4,
                left: 4,
              }}
            >

              <CartesianGrid
                stroke="var(--grid)"
                strokeDasharray="3 3"
                vertical={false}
              />


              <XAxis
                dataKey="label"
                minTickGap={25}
                tick={{
                  fill:
                    'var(--muted)',
                  fontSize: 9,
                }}
              />


              <YAxis
                tick={{
                  fill:
                    'var(--muted)',
                  fontSize: 9,
                }}
              />


              <Tooltip
                contentStyle={{
                  background:
                    'var(--tooltip)',
                  border:
                    '1px solid var(--border)',
                  borderRadius: 12,
                  color:
                    'var(--text)',
                }}
              />


              <Area
                type="monotone"
                dataKey="observed"
                stroke="#6c8cff"
                fill="#6c8cff"
                fillOpacity={0.3}
                name="Observed frequency"
              />


              <Line
                type="monotone"
                dataKey="normal"
                stroke="#f59e0b"
                strokeWidth={2.3}
                dot={false}
                name="Fitted normal curve"
              />

            </ComposedChart>

          </ResponsiveContainer>

        </div>
      )}


      {result ? (
        <>

          <div className="test-result-grid normality-results">

            <div>
              <span>
                Observations
              </span>

              <strong>
                {result.count}
              </strong>
            </div>


            <div>
              <span>
                Mean
              </span>

              <strong>
                {result.average.toFixed(6)}
              </strong>
            </div>


            <div>
              <span>
                Standard deviation
              </span>

              <strong>
                {
                  result
                    .standardDeviation
                    .toFixed(6)
                }
              </strong>
            </div>


            <div>
              <span>
                Skewness
              </span>

              <strong>
                {result.skewness.toFixed(6)}
              </strong>
            </div>


            <div>
              <span>
                Excess kurtosis
              </span>

              <strong>
                {
                  result
                    .excessKurtosis
                    .toFixed(6)
                }
              </strong>
            </div>


            <div>
              <span>
                JB statistic
              </span>

              <strong>
                {result.statistic.toFixed(6)}
              </strong>
            </div>


            <div>
              <span>
                p-value
              </span>

              <strong>
                {result.pValue.toFixed(6)}
              </strong>
            </div>

          </div>


          <Decision
            pValue={result.pValue}
            alpha={alpha}
          />

        </>
      ) : (
        <div className="calculator-message">
          Enter at least four non-constant values.
        </div>
      )}


      <div className="test-explanation">

        <strong>
          Important interpretation
        </strong>

        <p>
          Rejecting the null hypothesis provides
          evidence against normality. Not rejecting
          it does not prove that the distribution is
          normal. Always examine the histogram,
          skewness, kurtosis, sample size, and the
          purpose of the analysis together.
        </p>

      </div>

    </article>
  )
}


function DictionaryCalculators() {
  const [valuesInput, setValuesInput] =
    useState(
      '10, 12, 9, 15, 14',
    )

  const values =
    useMemo(
      () =>
        parseValues(
          valuesInput,
        ),
      [valuesInput],
    )

  const descriptive =
    useMemo(() => {
      if (values.length < 2) {
        return null
      }

      const average =
        mean(values)

      const variance =
        sampleVariance(values)

      return {
        count:
          values.length,

        average,

        variance,

        standardDeviation:
          Math.sqrt(variance),

        minimum:
          Math.min(...values),

        maximum:
          Math.max(...values),
      }
    }, [values])


  return (
    <section className="dictionary-calculators">

      <div className="dictionary-section-heading">

        <span>
          Interactive learning
        </span>

        <h2>
          Statistical calculators and tests
        </h2>

        <p>
          Enter values and parameters to see each
          calculation, reference distribution,
          rejection region, p-value, and decision.
        </p>

      </div>


      <article className="calculator-card descriptive-calculator">

        <h3>
          Descriptive statistics
        </h3>

        <p>
          Enter sample values separated by commas,
          spaces, or semicolons.
        </p>


        <textarea
          value={valuesInput}
          onChange={event =>
            setValuesInput(
              event.target.value,
            )
          }
        />


        {descriptive ? (
          <div className="calculator-results descriptive-results">

            <span>
              Observations
              <strong>
                {descriptive.count}
              </strong>
            </span>

            <span>
              Arithmetic mean
              <strong>
                {
                  descriptive
                    .average
                    .toFixed(6)
                }
              </strong>
            </span>

            <span>
              Sample variance
              <strong>
                {
                  descriptive
                    .variance
                    .toFixed(6)
                }
              </strong>
            </span>

            <span>
              Sample standard deviation
              <strong>
                {
                  descriptive
                    .standardDeviation
                    .toFixed(6)
                }
              </strong>
            </span>

            <span>
              Minimum
              <strong>
                {descriptive.minimum}
              </strong>
            </span>

            <span>
              Maximum
              <strong>
                {descriptive.maximum}
              </strong>
            </span>

          </div>
        ) : (
          <div className="calculator-message">
            Enter at least two valid values.
          </div>
        )}

      </article>


      <div className="hypothesis-test-stack">

        <OneSampleTTest />

        <OneSampleZTest />

        <JarqueBeraNormalityTest />

      </div>

    </section>
  )
}


export default DictionaryCalculators