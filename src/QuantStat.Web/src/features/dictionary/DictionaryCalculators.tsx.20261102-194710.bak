import {
  useMemo,
  useState,
} from 'react'

function parseValues(input: string): number[] {
  return input
    .split(/[\s,;]+/)
    .map(value => Number(value))
    .filter(value => Number.isFinite(value))
}

function mean(values: number[]): number {
  return values.reduce(
    (sum, value) => sum + value,
    0,
  ) / values.length
}

function sampleVariance(values: number[]): number {
  const average = mean(values)

  return values.reduce(
    (sum, value) =>
      sum +
      (value - average) ** 2,
    0,
  ) / (values.length - 1)
}

function DictionaryCalculators() {
  const [valuesInput, setValuesInput] =
    useState('10, 12, 9, 15, 14')

  const [previousPrice, setPreviousPrice] =
    useState('100')

  const [currentPrice, setCurrentPrice] =
    useState('105')

  const [sampleMean, setSampleMean] =
    useState('102')

  const [nullMean, setNullMean] =
    useState('100')

  const [sampleSd, setSampleSd] =
    useState('8')

  const [sampleSize, setSampleSize] =
    useState('25')

  const values =
    useMemo(
      () => parseValues(valuesInput),
      [valuesInput],
    )

  const descriptive =
    useMemo(() => {
      if (values.length < 2) {
        return null
      }

      const arithmetic = mean(values)
      const variance = sampleVariance(values)

      return {
        count: values.length,
        mean: arithmetic,
        variance,
        standardDeviation:
          Math.sqrt(variance),
        minimum: Math.min(...values),
        maximum: Math.max(...values),
      }
    }, [values])

  const priceOne =
    Number(previousPrice)

  const priceTwo =
    Number(currentPrice)

  const simpleReturn =
    priceOne > 0
      ? (priceTwo - priceOne) / priceOne
      : Number.NaN

  const logReturn =
    priceOne > 0 && priceTwo > 0
      ? Math.log(priceTwo / priceOne)
      : Number.NaN

  const xBar = Number(sampleMean)
  const muZero = Number(nullMean)
  const s = Number(sampleSd)
  const n = Number(sampleSize)

  const tStatistic =
    s > 0 && n > 0
      ? (xBar - muZero) /
        (s / Math.sqrt(n))
      : Number.NaN

  return (
    <section className="dictionary-calculators">
      <div className="dictionary-section-heading">
        <div>
          <span>Interactive</span>
          <h2>Statistical calculators</h2>
          <p>
            Small tools for exploring the formulas
            used throughout QuantStat.
          </p>
        </div>
      </div>

      <div className="calculator-grid">
        <article className="calculator-card">
          <h3>Descriptive statistics</h3>
          <p>
            Enter values separated by commas,
            spaces, or semicolons.
          </p>

          <textarea
            value={valuesInput}
            onChange={event =>
              setValuesInput(event.target.value)
            }
          />

          {descriptive ? (
            <div className="calculator-results">
              <span>n <strong>{descriptive.count}</strong></span>
              <span>Mean <strong>{descriptive.mean.toFixed(6)}</strong></span>
              <span>Variance <strong>{descriptive.variance.toFixed(6)}</strong></span>
              <span>SD <strong>{descriptive.standardDeviation.toFixed(6)}</strong></span>
              <span>Minimum <strong>{descriptive.minimum}</strong></span>
              <span>Maximum <strong>{descriptive.maximum}</strong></span>
            </div>
          ) : (
            <div className="calculator-message">
              Enter at least two valid values.
            </div>
          )}
        </article>

        <article className="calculator-card">
          <h3>Market return</h3>
          <p>
            Compare simple return and
            continuously compounded return.
          </p>

          <div className="calculator-input-row">
            <label>
              Previous price
              <input
                type="number"
                value={previousPrice}
                onChange={event =>
                  setPreviousPrice(event.target.value)
                }
              />
            </label>

            <label>
              Current price
              <input
                type="number"
                value={currentPrice}
                onChange={event =>
                  setCurrentPrice(event.target.value)
                }
              />
            </label>
          </div>

          <div className="calculator-results">
            <span>
              Simple return
              <strong>
                {Number.isFinite(simpleReturn)
                  ? `${(simpleReturn * 100).toFixed(4)}%`
                  : '—'}
              </strong>
            </span>

            <span>
              Log return
              <strong>
                {Number.isFinite(logReturn)
                  ? `${(logReturn * 100).toFixed(4)}%`
                  : '—'}
              </strong>
            </span>
          </div>
        </article>

        <article className="calculator-card">
          <h3>One-sample t statistic</h3>
          <p>
            Calculate the test statistic for
            H₀: μ = μ₀.
          </p>

          <div className="calculator-input-grid">
            <label>
              Sample mean
              <input
                type="number"
                value={sampleMean}
                onChange={event =>
                  setSampleMean(event.target.value)
                }
              />
            </label>

            <label>
              Null mean
              <input
                type="number"
                value={nullMean}
                onChange={event =>
                  setNullMean(event.target.value)
                }
              />
            </label>

            <label>
              Sample SD
              <input
                type="number"
                value={sampleSd}
                onChange={event =>
                  setSampleSd(event.target.value)
                }
              />
            </label>

            <label>
              Sample size
              <input
                type="number"
                value={sampleSize}
                onChange={event =>
                  setSampleSize(event.target.value)
                }
              />
            </label>
          </div>

          <div className="calculator-primary-result">
            <span>t statistic</span>
            <strong>
              {Number.isFinite(tStatistic)
                ? tStatistic.toFixed(6)
                : '—'}
            </strong>
            <small>
              Degrees of freedom: {
                Number.isFinite(n) && n >= 1
                  ? n - 1
                  : '—'
              }
            </small>
          </div>
        </article>
      </div>
    </section>
  )
}

export default DictionaryCalculators