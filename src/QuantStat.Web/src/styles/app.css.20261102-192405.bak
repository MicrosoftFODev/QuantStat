:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color-scheme: dark;

  --background: #090d18;
  --sidebar: #0d1321;
  --surface: #111827;
  --surface-2: #151e2f;
  --border: #233048;
  --text: #f4f7ff;
  --muted: #8d9ab2;
  --accent: #6c8cff;
  --accent-soft: rgba(108, 140, 255, 0.13);
  --grid: rgba(141, 154, 178, 0.13);
  --tooltip: #101827;
  --positive: #34d399;
  --negative: #fb7185;

  background: var(--background);
  color: var(--text);
}

:root[data-theme="light"] {
  color-scheme: light;

  --background: #f3f6fb;
  --sidebar: #ffffff;
  --surface: #ffffff;
  --surface-2: #f8faff;
  --border: #dce3ef;
  --text: #172033;
  --muted: #69758b;
  --accent: #526fe8;
  --accent-soft: rgba(82, 111, 232, 0.11);
  --grid: rgba(80, 98, 130, 0.13);
  --tooltip: #ffffff;
  --positive: #059669;
  --negative: #e11d48;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-width: 320px;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  background: var(--background);
  color: var(--text);
}

button,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 240px 1fr;
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px 22px;
  border-bottom: 1px solid var(--border);
}

.brand-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: white;
  background:
    linear-gradient(
      135deg,
      #6c8cff,
      #8b5cf6
    );
  box-shadow:
    0 12px 32px
    rgba(108, 140, 255, 0.25);
}

.brand strong {
  display: block;
  font-size: 17px;
}

.brand span {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  color: var(--muted);
}

nav {
  padding-top: 20px;
  display: grid;
  gap: 5px;
}

.nav-item {
  min-height: 44px;
  width: 100%;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--muted);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 11px;
  text-align: left;
}

.nav-item:hover {
  color: var(--text);
  background: var(--surface-2);
}

.nav-item.active {
  color: #dfe6ff;
  background: var(--accent-soft);
  border-color:
    rgba(108, 140, 255, 0.22);
}

.nav-item small {
  margin-left: auto;
  font-size: 9px;
  text-transform: uppercase;
  color: var(--muted);
}

.sidebar-footer {
  margin-top: auto;
  padding: 15px 10px 0;
  border-top: 1px solid var(--border);
}

.sidebar-footer span,
.sidebar-footer small {
  display: block;
}

.sidebar-footer span {
  font-size: 12px;
}

.sidebar-footer small {
  margin-top: 4px;
  color: var(--muted);
}

.main-area {
  min-width: 0;
  padding: 28px 34px 50px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.topbar h1 {
  margin: 0;
  font-size: 28px;
}

.topbar p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.theme-button {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.filters {
  display: flex;
  align-items: end;
  gap: 12px;
  padding: 16px;
  margin-bottom: 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.filters label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.filters select {
  min-width: 165px;
  height: 40px;
  padding: 0 36px 0 12px;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  outline: none;
}

.refresh-button {
  height: 40px;
  margin-left: auto;
  padding: 0 18px;
  color: white;
  background: var(--accent);
  border: 0;
  border-radius: 10px;
}

.metric-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}

.metric-card,
.chart-card,
.loading-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow:
    0 14px 45px
    rgba(0, 0, 0, 0.08);
}

.metric-card {
  min-height: 125px;
  padding: 19px;
}

.metric-card span {
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.metric-card strong {
  display: block;
  margin-top: 17px;
  font-size: 24px;
}

.metric-card small {
  display: block;
  margin-top: 8px;
  color: var(--muted);
}

.positive {
  color: var(--positive);
}

.negative {
  color: var(--negative);
}

.chart-card {
  padding: 20px;
  margin-bottom: 18px;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.card-heading h2 {
  margin: 0;
  font-size: 17px;
}

.card-heading p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.legend {
  display: flex;
  gap: 18px;
  color: var(--muted);
  font-size: 11px;
}

.price-key::before,
.mean-key::before {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-right: 7px;
  border-radius: 50%;
  content: "";
}

.price-key::before {
  background: #6c8cff;
}

.mean-key::before {
  background: #f59e0b;
}

.chart-container {
  width: 100%;
  height: 360px;
}

.rsi-chart {
  height: 260px;
}

.rsi-value {
  color: #a78bfa;
  font-size: 23px;
  font-weight: 700;
}

.loading-card {
  padding: 30px;
  color: var(--muted);
  text-align: center;
}

.error-banner {
  padding: 14px 16px;
  margin-bottom: 18px;
  color: #fecdd3;
  background: rgba(225, 29, 72, 0.13);
  border: 1px solid rgba(225, 29, 72, 0.3);
  border-radius: 12px;
}

@media (max-width: 1100px) {
  .metric-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    position: static;
    width: 100%;
    height: auto;
  }

  nav {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .sidebar-footer {
    display: none;
  }

  .main-area {
    padding: 22px 16px 40px;
  }

  .filters {
    align-items: stretch;
    flex-direction: column;
  }

  .filters select {
    width: 100%;
  }

  .refresh-button {
    margin-left: 0;
  }

  .metric-grid {
    grid-template-columns: 1fr;
  }

  .chart-container {
    height: 300px;
  }
}

/* ==========================================================
   STATISTICS
   ========================================================== */

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.page-heading h1 {
  margin: 0;
  font-size: 28px;
}

.page-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.statistics-summary-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}

.stat-icon {
  float: right;
  color: var(--accent);
}

.statistics-sections {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.statistics-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 21px;
  box-shadow:
    0 14px 45px
    rgba(0, 0, 0, 0.06);
}

.statistics-card-header {
  padding-bottom: 17px;
  margin-bottom: 6px;
  border-bottom:
    1px solid var(--border);
}

.statistics-card-header h2 {
  margin: 0;
  font-size: 16px;
}

.statistics-card-header p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.stat-table {
  display: grid;
}

.stat-table > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 49px;
  border-bottom:
    1px solid var(--border);
}

.stat-table > div:last-child {
  border-bottom: 0;
}

.stat-table span {
  color: var(--muted);
  font-size: 12px;
}

.stat-table strong {
  font-size: 13px;
  font-variant-numeric:
    tabular-nums;
}

.quantile-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 10px;
  padding-top: 16px;
}

.quantile-grid > div {
  padding: 16px 10px;
  text-align: center;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.quantile-grid span,
.quantile-grid strong {
  display: block;
}

.quantile-grid span {
  color: var(--muted);
  font-size: 11px;
}

.quantile-grid strong {
  margin-top: 8px;
  font-size: 13px;
}

@media (max-width: 1100px) {
  .statistics-summary-grid,
  .statistics-sections {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .statistics-summary-grid,
  .statistics-sections {
    grid-template-columns: 1fr;
  }

  .quantile-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}
/* ==========================================================
   ROUTING / LAYOUT
   ========================================================== */

.nav-item {
  text-decoration: none;
}

.app-toolbar {
  min-height: 46px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  margin-bottom: 20px;
}

.app-toolbar-status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 11px;
}

.status-dot {
  width: 7px;
  height: 7px;
  display: block;
  border-radius: 50%;
  background: #34d399;
  box-shadow:
    0 0 0 4px
    rgba(52, 211, 153, 0.1);
}

.placeholder-card {
  min-height: 300px;
  display: grid;
  place-items: center;
  align-content: center;
  padding: 40px;
  text-align: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.placeholder-card h2 {
  margin: 16px 0 7px;
}

.placeholder-card p {
  margin: 0;
  color: var(--muted);
}

.placeholder-badge {
  padding: 7px 11px;
  color: #a5b4fc;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  background: var(--accent-soft);
  border-radius: 999px;
}

/* ==========================================================
   SHARED DASHBOARD SELECTION
   ========================================================== */

.selection-summary {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(150px, 1fr))
    minmax(240px, 1.4fr);
  gap: 12px;
  padding: 16px;
  margin-bottom: 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.selection-summary > div {
  min-height: 56px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 9px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 11px;
}

.selection-summary span {
  color: var(--muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.selection-summary strong {
  margin-top: 6px;
  font-size: 13px;
}

.selection-summary .selection-note {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

@media (max-width: 900px) {
  .selection-summary {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .selection-summary {
    grid-template-columns: 1fr;
  }
}
/* ==========================================================
   FULL CHARTS
   ========================================================== */

.large-chart {
  height: 430px;
}

.indicator-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.indicator-card {
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow:
    0 14px 45px
    rgba(0, 0, 0, 0.06);
}

.indicator-card:last-child {
  grid-column: 1 / -1;
}

.indicator-chart {
  width: 100%;
  height: 260px;
}

.indicator-value {
  font-size: 22px;
  font-variant-numeric:
    tabular-nums;
}

@media (max-width: 1000px) {
  .indicator-grid {
    grid-template-columns: 1fr;
  }

  .indicator-card:last-child {
    grid-column: auto;
  }
}